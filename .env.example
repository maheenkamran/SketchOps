# Copy this file to .env and fill in your own keys:  cp .env.example .env
# .env is in .gitignore. Never commit it and never paste keys in chat.

# ---- D1: needed to run the agent for real ----
GEMINI_API_KEY=        # https://aistudio.google.com/apikey  (main generator)
GROQ_API_KEY=          # https://console.groq.com/keys       (fallback generator + LLM judge)
MOCK_MODE=0            # 1 = fake LLM and renderer, no keys needed (tests use this)
SCORER=trained         # trained = registered champion, handtuned = SigLIP+judge, placeholder = always 0.5
# Shared MLflow on DagsHub (leave all three empty to use the local mlflow.db instead).
# Password = your DagsHub token. No comment after the values (see below).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# DagsHub login for the Docker pipeline run (docker run --env-file .env ...). Token: DagsHub > Settings > Tokens.
# Keep these two lines without a comment after the value: Docker's --env-file reads comments as part of the value.
DAGSHUB_USER=
DAGSHUB_TOKEN=

# ---- D2 (Maheen): leave empty for now ----
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
AZURE_STORAGE_CONNECTION_STRING=
PUBLIC_BASE_URL=http://localhost:8000
